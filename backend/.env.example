# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/amanahtrack

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_TEMPLATE_NAME=donor_payment_confirmation
WHATSAPP_TEMPLATE_NAME_ML=donor_payment_confirmation_ml

# Admin Seed (for first run)
ADMIN_EMAIL=admin@amanahtrack.com
ADMIN_PASSWORD=Admin@123456
