# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp_broadcast

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Gupshup WhatsApp API
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_SOURCE_MOBILE=+91xxxxxxxxxx
GUPSHUP_APP_NAME=your_gupshup_app_name

# Broadcast / Notification batch settings
WHATSAPP_BATCH_SIZE=50
WHATSAPP_BATCH_DELAY_MS=1000

# Admin Seed (for first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
